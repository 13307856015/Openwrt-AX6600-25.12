diff --git a/target/linux/qualcommax/ipq60xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq60xx/base-files/lib/upgrade/platform.sh
index d313635..26e98b2 100644
--- a/target/linux/qualcommax/ipq60xx/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq60xx/base-files/lib/upgrade/platform.sh
@@ -1,3 +1,30 @@
+# 25.12 does not ship find_mmc_part(); add a small self-contained helper that
+# resolves GPT partition labels ("rootfs", "0:HLOS", ...) on the boot mmc.
+find_mmc_part() {
+	local partname="$1"
+	local devname="$2"
+	local part label
+
+	[ -n "$partname" ] || return 1
+
+	if [ -z "$devname" ]; then
+		devname="$(sed -n 's/^.*root=\(\/dev\/mmcblk[0-9]*\).*$/\1/p' /proc/cmdline)"
+	fi
+	[ -n "$devname" ] || devname="/dev/mmcblk0"
+
+	for part in "$devname"p*; do
+		[ -b "$part" ] || continue
+		label="$(sed -n 's/^PARTNAME=//p' "/sys/class/block/${part##*/}/uevent" 2>/dev/null)"
+		[ -n "$label" ] || continue
+		if [ "$label" = "$partname" ] || [ "$label" = "${partname#*:}" ]; then
+			echo "$part"
+			return 0
+		fi
+	done
+
+	return 1
+}
+
 PART_NAME=firmware
 REQUIRE_IMAGE_METADATA=1
 
@@ -127,6 +154,18 @@ platform_do_upgrade() {
 		remove_oem_ubi_volume ubi_rootfs
 		nand_do_upgrade "$1"
 		;;
+	jdcloud,re-cs-02)
+		local cfgpart=$(find_mmc_part "0:BOOTCONFIG")
+		part_num="$(hexdump -e '1/1 "%01x|"' -n 1 -s 148 -C $cfgpart | cut -f 1 -d "|" | head -n1)"
+		if [ "$part_num" -eq "1" ]; then
+			CI_KERNPART="0:HLOS_1"
+			CI_ROOTPART="rootfs_1"
+		else
+			CI_KERNPART="0:HLOS"
+			CI_ROOTPART="rootfs"
+		fi
+		emmc_do_upgrade "$1"
+		;;
 	linksys,mr7350|\
 	linksys,mr7500)
 		boot_part="$(fw_printenv -n boot_part)"
